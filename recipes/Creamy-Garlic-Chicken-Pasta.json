  "steps": [
    {
      "step": "Cook pasta in salted water until al dente. Reserve ½ cup pasta water."
    },
    {
      "step": "Season chicken with salt and pepper, cook in a pan until golden. Remove."
    },
    {
      "step": "In same pan, melt butter and cook garlic (don’t burn it)."
    },
    {
      "step": "Add cream, simmer 2–3 mins."
    },
    {
      "step": "Stir in parmesan until smooth."
    },
    {
      "step": "Add chicken back in + optional veg."
    },
    {
      "step": "Toss pasta through sauce. Add pasta water if needed."
    },
    {
      "step": "Serve immediately."
    }
